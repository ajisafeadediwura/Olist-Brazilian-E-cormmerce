/*
===============================================================================
Layer:        bronze -> silver (profiling before cleaning)
Table:        bronze.customers
Purpose:      Profile the raw customers table BEFORE cleaning, so every
              cleaning decision in silver is based on evidence.
Database:     OlistAnalytics (SQL Server)

How to use this file:
  1. Run each check one at a time.
  2. Paste the key numbers into the RESULT line straight away.
  3. Write the FINDING (what it means) and the DECISION (what you will do).
  4. Copy each finding into docs/03_data_quality_log.md.
  Do not change any data in this script. It only reads.
===============================================================================
*/

USE OlistAnalytics;
GO
/*
CHECK 1: Table grain
Purpose: Confirm the relationship between customer_id and customer_unique_id.
*/
SELECT COUNT(*)                           AS total_rows,
       COUNT(DISTINCT customer_id)        AS distinct_customer_id,
       COUNT(DISTINCT customer_unique_id) AS distinct_unique_ids
FROM bronze.customers;

-- Result:   99,441 rows | 99,441 customer_id | 96,096 customer_unique_id
-- Finding:  customer_id is generated per order; customer_unique_id identifies the
--           person. Some customers ordered more than once.
-- Decision: Use customer_unique_id for all customer-level metrics.


/*
CHECK 2: Hidden carriage returns
Purpose: Confirm that line endings did not leave a stray CHAR(13) in the last
column (customer_state).
*/
SELECT COUNT(*) AS rows_with_hidden_cr
FROM bronze.customers
WHERE customer_state LIKE '%' + CHAR(13) + '%';

-- Result:   0 rows
-- Finding:  No hidden carriage returns. The source file uses \n line endings,
--           which matches the ROWTERMINATOR = '0x0a' setting in the bronze load.
-- Decision: No carriage-return removal needed for customers.

/*
CHECK 3: State code validity
Purpose: Confirm customer_state contains only valid Brazilian state codes.
*/
SELECT customer_state,
       LEN(customer_state) AS length,
       COUNT(*)            AS customers
FROM bronze.customers
GROUP BY customer_state
ORDER BY customers DESC;

-- Result:   27 distinct values, all 2 characters
-- Finding:  customer_state is clean. The 27 values match Brazil's 26 states plus
--           the Federal District, with no stray spaces or malformed codes.
-- Decision: Upper-case and trim customer_state in silver as a standardisation
--           safeguard. No rows are expected to change.
/*
CHECK 4: City name consistency
Purpose: Check whether the same city appears under variants that differ only
by leading/trailing spaces or letter case.
*/
SELECT COUNT(DISTINCT customer_city)              AS raw_cities,
       COUNT(DISTINCT LOWER(TRIM(customer_city))) AS cleaned_cities
FROM bronze.customers;

-- Result:   raw_cities = <your number> | cleaned_cities = <same number>
-- Finding:  No variants caused by spacing or casing.
-- Decision: Apply TRIM and LOWER to city in silver as a standardisation
--           safeguard. No rows are expected to change.

